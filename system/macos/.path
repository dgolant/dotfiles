export HOMEBREW_PREFIX=$($DOTFILES_DIR/bin/is-supported $DOTFILES_DIR/bin/is-arm64 /opt/homebrew /usr/local)

# Prepend new items to path (if directory exists)

prepend-path "$HOMEBREW_PREFIX/bin"
prepend-path "$HOMEBREW_PREFIX/sbin"
prepend-path "$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/curl/bin"
prepend-path "$HOMEBREW_PREFIX/opt/findutils/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/gawk/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/gnu-tar/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/gpatch/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/grep/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/make/libexec/gnubin"
prepend-path "$HOMEBREW_PREFIX/opt/python/libexec/bin"
prepend-path "$HOMEBREW_PREFIX/opt/ruby/bin"
prepend-path "$HOME/.bun/bin"
prepend-path "$HOME/.cargo/bin"
prepend-path "$HOME/.local/bin"
prepend-path "$N_PREFIX/bin"
prepend-path "$HOME/.pyenv/shims/python"
prepend-path "$HOME/dd/devtools/bin"
prepend-path "$HOME/dev/scripts"

# Add mysql-client to PATH (skimm only, not installed by default)
prepend-path "/usr/local/opt/mysql-client/bin"
# Add psql
prepend-path "/Applications/Postgres.app/Contents/Versions/latest/bin"
