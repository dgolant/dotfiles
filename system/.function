# Switch long/short prompt

ps0() {
  unset PROMPT_COMMAND
  PS1='$ '
}

ps1() {
  source "$DOTFILES_DIR"/system/.prompt
}

ps2() {
  unset PROMPT_COMMAND
  PS1="${P_GREEN}$ ${P_RESET}"
}

# Get named var (usage: get "VAR_NAME")

get() {
  echo "${!1}"
}

# Calculator

calc() {
  echo "$*" | bc -l;
}

# Weather

meteo() {
  local LOCALE=$(echo ${LANG:-en} | cut -c1-2)
  local LOCATION="$*"
  LOCATION="${LOCATION// /%20}"
  curl -s "$LOCALE.wttr.in/${LOCATION:-}"
}

# Print the terminal's color palette (16 base colors) followed by
# representative output rendered through the active theme. Sample
# files live in $DOTFILES_DIR/config/gogh/samples; real tools
# (bat, git, jq, eza, grep) colorize them, so the preview shows
# exactly what daily tooling emits. Log levels stay manual — lnav
# is monochrome in headless (-n) mode.

colors() {
  local i
  local B=$'\033[1m' R=$'\033[0m'
  local red=$'\033[31m' grn=$'\033[32m' yel=$'\033[33m' blu=$'\033[34m'
  local cyn=$'\033[36m' gry=$'\033[90m' wht=$'\033[97m'
  local dir="${DOTFILES_DIR:-$HOME/.dotfiles}/config/gogh/samples"

  sec() { printf '\n%s── %s ──%s\n' "$B" "$1" "$R"; }

  sec "16 base colors"
  for i in $(seq 0 15); do printf "\e[48;5;${i}m%-5s\e[m" "$i"; done; echo

  [ -d "$dir" ] || { echo "No samples directory: $dir" >&2; return 1; }

  sec "code (bat)"
  if is-executable bat; then
    bat --color=always --paging=never "$dir/app.js"
  else
    cat "$dir/app.js"
  fi

  sec "diff (git)"
  git diff --no-index --color=always "$dir/app.old.js" "$dir/app.js" || true

  sec "json (jq)"
  if is-executable jq; then
    jq -C . "$dir/config.json"
  else
    cat "$dir/config.json"
  fi

  sec "markdown (bat)"
  if is-executable bat; then
    bat --color=always --paging=never "$dir/notes.md"
  else
    cat "$dir/notes.md"
  fi

  sec "ls (eza)"
  if is-executable eza; then
    eza -la --group --color=always "$dir"
  else
    ls -la "$dir"
  fi

  sec "grep"
  grep -n --color=always "port" "$dir/app.js" || true

  sec "logs"
  printf '%s\n' \
    "${cyn}12:04:17${R} ${gry}DEBUG${R}  cache hit user=42" \
    "${cyn}12:04:18${R} ${grn}INFO ${R}  server listening on ${wht}0.0.0.0:8000${R}" \
    "${cyn}12:04:19${R} ${yel}WARN ${R}  upstream timeout, retry ${wht}1/3${R}" \
    "${cyn}12:04:20${R} ${red}ERROR${R} connection refused: ${red}ECONNREFUSED${R}"

}
