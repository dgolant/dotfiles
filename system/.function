# Switch long/short prompt

ps0() {
  unset PROMPT_COMMAND
  PS1='$ '
}

ps1() {
  source "$DOTFILES_DIR"/system/.prompt
}

ps2() {
  unset PROMPT_COMMAND
  PS1="${P_GREEN}$ ${P_RESET}"
}

# Get named var (usage: get "VAR_NAME")

get() {
  echo "${!1}"
}

# Calculator

calc() {
  echo "$*" | bc -l;
}

# Weather

meteo() {
  local LOCALE=$(echo ${LANG:-en} | cut -c1-2)
  local LOCATION="$*"
  LOCATION="${LOCATION// /%20}"
  curl -s "$LOCALE.wttr.in/${LOCATION:-}"
}

# Print the terminal's color palette (16 base, 256-color grid, truecolor
# gradient) followed by representative output rendered with the active
# palette — so applying a gogh theme and running `colors` previews it IRL.

colors() {
  local i r
  local B=$'\033[1m' D=$'\033[2m' R=$'\033[0m'
  local red=$'\033[31m' grn=$'\033[32m' yel=$'\033[33m' blu=$'\033[34m'
  local mag=$'\033[35m' cyn=$'\033[36m' gry=$'\033[90m' wht=$'\033[97m'

  sec() { printf '\n%s── %s ──%s\n' "$B" "$1" "$R"; }

  sec "16 base colors"
  for i in $(seq 0 15); do printf "\e[48;5;${i}m%-5s\e[m" "$i"; done; echo

  sec "256-color grid"
  for i in $(seq 16 255); do
    printf "\e[48;5;${i}m%-5s\e[m" "$i"
    [ $(( (i-15) % 12 )) -eq 0 ] && echo
  done

  sec "truecolor gradient (24-bit support test)"
  for r in $(seq 0 8 255); do printf "\e[48;2;${r};$((255-r));128m \e[m"; done; echo

  sec "logs"
  printf '%s\n' \
    "${cyn}12:04:17${R} ${gry}DEBUG${R}  cache hit user=42" \
    "${cyn}12:04:18${R} ${grn}INFO ${R}  server listening on ${wht}0.0.0.0:8000${R}" \
    "${cyn}12:04:19${R} ${yel}WARN ${R}  upstream timeout, retry ${wht}1/3${R}" \
    "${cyn}12:04:20${R} ${red}ERROR${R} connection refused: ${red}ECONNREFUSED${R}"

  sec "git"
  printf '%s\n' \
    "${yel}commit 9f13a71${R} (HEAD -> ${cyn}master${R})" \
    "${grn}feat: add colors showcase${R}" \
    "" \
    "${D}diff --git a/src/app.ts b/src/app.ts${R}" \
    "${mag}@@ -12,5 +12,6 @@${R}" \
    "  ${D}const retries = 3;${R}" \
    "${red}- const port = 3000;${R}" \
    "${grn}+ const port = ${cyn}8000${R}${grn};${R}" \
    "${grn}+ const host = ${wht}\"0.0.0.0\"${R}${grn};${R}"

  sec "code"
  printf '%s\n' \
    "${gry}// src/app.tsx${R}" \
    "${blu}export${R} ${mag}function${R} ${grn}greet${R}(name: ${cyn}string${R}) {" \
    "  ${yel}if${R} (!name) ${yel}return${R} ${grn}\"\"${R};" \
    "  ${mag}return${R} \`Hello, \${name}!\`;"\
    "}"

  sec "ls / grep"
  printf '%s %s %s %s\n' "${blu}src/${R}" "${grn}run.sh${R}${wht}*${R} ${mag}app -> ../lib/app${R}" "README.md" "${D}notes.txt${R}"
  printf 'grep -rn port %s\n' "${wht}src/app.ts${R}"
  printf '%s\n' "${cyn}src/app.ts${R}:${wht}12${R}:  const port = ${red}8000${R};"

  sec "prompt"
  printf '%s' "${grn}➜${R} ${blu}dotfiles${R} ${mag}(master)${R} "
  printf '%s %s\n' "${grn}ls -la${R}" "${D}# try: colors | less -R${R}"
}
